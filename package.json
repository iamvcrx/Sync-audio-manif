{
  "name": "soundworks-audio-manif",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run clean && sass src/styles/main.scss:.build/public/css/app.css && soundworks-build -b",
    "clean": "soundworks-build -D",
    "dev": "npm run build && concurrently -i -p \"none\" \"npm run watch:inspect server\" \"soundworks-build -b -w\" \"npm run watch:sass\"",
    "lint": "npx eslint src",
    "start": "node .build/server.js",
    "watch:inspect": "soundworks-build -i -p",
    "watch:sass": "sass --watch src/styles/main.scss:.build/public/css/app.css"
  },
  "dependencies": {
    "@soundworks/core": "^5.0.0",
    "@soundworks/helpers": "^5.0.0",
    "@soundworks/plugin-checkin": "^5.0.0",
    "@soundworks/plugin-platform-init": "^5.0.0",
    "@soundworks/plugin-sync": "^5.0.0",
    "lit": "^3.1.3"
  },
  "devDependencies": {
    "@ircam/eslint-config": "^2.0.1",
    "@soundworks/build": "^5.0.0",
    "@types/node": "^22.10.10",
    "@types/web": "^0.0.199",
    "concurrently": "^8.2.2",
    "eslint": "^9.18.0",
    "sass": "^1.77.1"
  }
}
